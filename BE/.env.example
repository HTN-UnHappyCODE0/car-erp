# ==============================================================================
# CAR ERP BACKEND - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Sao chép file này thành .env và điền thông tin tương ứng cho môi trường của bạn.
# ==============================================================================

# Môi trường chạy hệ thống: 'development' | 'staging' | 'production'
APP_ENV=development

# Cổng lắng nghe của HTTP Server
SERVER_PORT=8080

# Khóa bí mật đối xứng dùng để ký JWT (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên bảo mật)
# Gợi ý sinh khóa: openssl rand -base64 32
TOKEN_SYMMETRIC_KEY=your-32-byte-ultra-secure-jwt-secret-key-here!

# Thời hạn hiệu lực của Access Token và Refresh Token
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# Kết nối Cơ sở dữ liệu PostgreSQL (Khuyến nghị bật sslmode=require ở Production)
DB_URL=postgresql://erp_admin:your_secure_password@localhost:5432/erp_automotive?sslmode=disable

# Cấu hình Connection Pool PostgreSQL
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Danh sách domain Frontend được phép gọi API (CORS Whitelist, phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
